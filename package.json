    "react": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deno/esbuild-plugin": "npm:@jsr/deno__esbuild-plugin@^1.2.1",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3"
  }
