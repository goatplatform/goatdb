{
  "name": "@goatdb/goatdb",
  "version": "0.0.0-dev",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./mod.ts",
    "./react": "./react/hooks.ts",
    "./server": "./server.ts",
    "./server/email": "./server/email.ts",
    "./server/build": "./server-build.ts",
    "./link": "./cli/link.ts"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/goatplatform/goatdb"
  },
  "engines": {
