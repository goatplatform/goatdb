{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"]
  },
  "imports": {
    "@deno-library/compress": "jsr:@deno-library/compress@0.5.6",
    "@std/path": "jsr:@std/path@1.1.1"
  },
  "nodeModulesDir": "manual",
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "singleQuote": true,
    "exclude": ["static/"]
  },
  "exclude": ["node_modules/", ".docusaurus/", "build/", "docs/"]
}
