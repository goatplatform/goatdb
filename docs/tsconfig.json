{
  // Used by `npm run typecheck` (tsc) and for editor tooling. The excluded
  // .ts files are Deno scripts whose jsr: specifiers tsc cannot resolve.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": "."
  },
  "exclude": [
    ".docusaurus",
    "build",
    "docs-api-build.ts",
    "docs-build.ts"
  ]
}
